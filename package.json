{
  "name": "bibo-tune",
  "productName": "Bibo Tune",
  "version": "0.1.53",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64",
    "test": "node --test test/system.test.cjs test/ui-version.test.cjs test/installer.test.cjs",
    "test:e2e": "playwright test",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist": "npm run build && electron-builder --mac --win --x64"
  },
  "build": {
    "appId": "it.bibo.tune",
    "productName": "Bibo Tune",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "uninstallDisplayName": "${productName}"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "afterPack": "build/afterPack.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "resedit": "^3.1.0",
    "vite": "^8.3.5"
  },
  "description": "Messa a punto del PC con il robot Bibo",
  "license": "UNLICENSED",
  "author": "Francesco Argento"
}
